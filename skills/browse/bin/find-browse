#!/bin/bash
# Shim: delegates to compiled find-browse binary; falls back to basic discovery
# along Soloship's plausible install paths.
set -e
DIR="$(cd "$(dirname "$0")/.." && pwd)/dist"
if test -x "$DIR/find-browse"; then
  exec "$DIR/find-browse" "$@"
fi
# Fallback: walk a small list of plausible Soloship install locations.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
CANDIDATES=()
[ -n "$ROOT" ] && CANDIDATES+=(
  "$ROOT/.codex/skills/soloship/skills/browse/dist/browse"
  "$ROOT/.agents/skills/soloship/skills/browse/dist/browse"
  "$ROOT/.claude/skills/soloship/skills/browse/dist/browse"
  "$ROOT/.claude/skills/browse/dist/browse"
)
CANDIDATES+=(
  "$HOME/plugins/soloship/skills/browse/dist/browse"
  "$HOME/.codex/.tmp/marketplaces/soloship/skills/browse/dist/browse"
  "$HOME/.codex/.tmp/plugins/plugins/soloship/skills/browse/dist/browse"
  "$HOME/.agents/skills/soloship/skills/browse/dist/browse"
  "$HOME/.claude/plugins/marketplaces/soloship/skills/browse/dist/browse"
  "$HOME/.claude/skills/soloship/skills/browse/dist/browse"
  "$HOME/.claude/skills/browse/dist/browse"
)
for C in "${CANDIDATES[@]}"; do
  if test -x "$C"; then
    echo "$C"
    exit 0
  fi
done
# Glob fallback for non-standard plugin install paths.
for FOUND in "$HOME"/plugins/soloship/skills/browse/dist/browse \
             "$HOME"/.codex/.tmp/marketplaces/*/skills/browse/dist/browse \
             "$HOME"/.codex/.tmp/marketplaces/*/*/skills/browse/dist/browse \
             "$HOME"/.codex/.tmp/plugins/plugins/soloship/skills/browse/dist/browse \
             "$HOME"/.codex/plugins/*/soloship*/skills/browse/dist/browse \
             "$HOME"/.claude/plugins/*/soloship*/skills/browse/dist/browse \
             "$HOME"/.claude/plugins/marketplaces/*/skills/browse/dist/browse; do
  if test -x "$FOUND"; then
    echo "$FOUND"
    exit 0
  fi
done
echo "ERROR: browse binary not found. Run scripts/build-soloship.sh inside the browse skill dir." >&2
exit 1
