node_modules/
dist/
# gs-browse builds its launcher binaries on first invocation (per-arch) rather
# than shipping them. dist/server-node.mjs is the Windows fallback bundle —
# small and arch-neutral, so we do ship it. The arch-specific compiled binaries
# (dist/browse, dist/find-browse, dist/.version) stay out of git.
!skills/gs-browse/dist/
skills/gs-browse/dist/browse
skills/gs-browse/dist/find-browse
skills/gs-browse/dist/.version
.ai/
**/.DS_Store

# Wrangler local state — not for version control
.wrangler/

# Serena MCP local state — not for version control
.serena/

# Internal working files — excluded from public repo
CLAUDE.md
docs/*
!docs/known-issues/
!docs/solutions/
site/
.claude/settings.local.json
.gstack/
.soloship/

# macOS dedup-suffix copies of skill files — never stage these
SKILL (*).md
